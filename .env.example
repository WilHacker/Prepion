# Copiar a .env y cambiar los valores. El archivo .env nunca se sube a Git.
POSTGRES_USER=prepion
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=prepion

# Conexión desde la PC (fuera de Docker). Dentro de Docker, docker-compose la sobrescribe.
DATABASE_URL=postgresql+psycopg://prepion:cambiar_esta_clave@localhost:5432/prepion

# Clave que exige POST /api/examenes/recolectar y que n8n envía en la cabecera
# X-Recoleccion-Token. Genera una propia: python -c "import secrets; print(secrets.token_urlsafe(32))"
RECOLECCION_TOKEN=cambiar_este_token
# Carpeta de PDF (solo si corres la API en tu PC; en Docker la fija docker-compose)
EXAMENES_PDF_DIR=../data/examenes_pdf

# Firma de las sesiones (login). Genera una: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambiar_este_secreto_largo_de_al_menos_32_caracteres
# Cuenta de administrador: se crea con `pnpm run admin:crear`.
ADMIN_CORREO=admin@prepion.bo
ADMIN_CONTRASENA=cambiar_esta_clave_admin
